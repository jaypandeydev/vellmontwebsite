# Copied to /opt/vellmont-careers/backup.env on the server. Sourced by backup.sh.
# cron runs with a minimal PATH; rclone is installed per-user under ~/.local/bin.
export PATH=/home/deploy/.local/bin:/usr/local/bin:/usr/bin:/bin
# rclone remote for the off-host copy — use a *crypt* remote with its own keys.
RCLONE_REMOTE=careers-crypt:
REMOTE_RETENTION_DAYS=90
# RETENTION_DAYS=30   # local dumps (default 30)
# Optional: a healthchecks.io-style URL pinged after each successful nightly run.
# HEARTBEAT_URL=
