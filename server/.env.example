# ── Vellmont careers API ─────────────────────────────────────────────────────
# Copy to .env for local dev (npm run dev), or to /etc/vellmont-careers.env on
# the VPS (loaded by the systemd unit). Never commit real values.

NODE_ENV=production
HOST=127.0.0.1
PORT=4010
# Public origin of the website (used in notification links)
PUBLIC_BASE_URL=https://vellmontservices.com
# 1 when running behind Caddy/nginx (one proxy hop) so rate limits key on the
# real client IP from X-Forwarded-For. Leave 0 when exposed directly.
TRUST_PROXY=1

# Postgres — applications, status history and (by default) CV bytes.
# e.g. postgresql://user:pass@host:5432/vellmont_careers  (Neon: add ?sslmode=require and DATABASE_SSL=1)
DATABASE_URL=
DATABASE_SSL=0

# CV storage: db (bytea rows, backed up with the database) or fs (private dir)
CV_STORAGE=db
# Only for CV_STORAGE=fs. Must be OUTSIDE the web root, e.g. /var/lib/vellmont-careers/cv
CV_STORAGE_DIR=

# Review dashboard sign-in (https://vellmontservices.com/careers/review)
# Generate the hash with:  npm run hash-password
REVIEW_USERNAME=
REVIEW_PASSWORD_HASH=
# 32+ random chars:  openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Optional separate salt for hashing submitter IPs (defaults to SESSION_SECRET)
IP_HASH_SALT=

# Email notification to the hiring team on every new application (optional).
# Leave SMTP_HOST empty to disable. Works with Resend SMTP, SES, Google Workspace, etc.
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vellmont Careers <careers@vellmontservices.com>"
# 1 to attach the CV to the notification (email-only delivery mode)
NOTIFY_ATTACH_CV=0

# Cloudflare Turnstile (optional bot challenge). Pair with VITE_TURNSTILE_SITE_KEY in the site build.
TURNSTILE_SECRET_KEY=

# Abuse limits. Attempt limits count EVERY POST to /applications (valid or
# not) per client IP and are enforced before the upload is parsed.
RATE_ATTEMPTS_PER_15MIN=8
RATE_ATTEMPTS_PER_DAY=30
RATE_LOGIN_PER_15MIN=10
MIN_FORM_SECONDS=4
DUPLICATE_WINDOW_MINUTES=60

# Notification retry: failed hiring-team emails are retried every
# NOTIFY_SWEEP_MINUTES until NOTIFY_MAX_ATTEMPTS, for rows under 7 days old.
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_SWEEP_MINUTES=10

# Database timeouts (ms) so an outage returns 503 instead of hanging requests.
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=15000
