# Site build-time settings (Vite). Copy to .env.local for local overrides.
# Careers API base path. Leave unset in production — Caddy proxies /api/careers/* to the Node service.
# VITE_CAREERS_API_URL=/api/careers
# Cloudflare Turnstile site key — only when TURNSTILE_SECRET_KEY is also set on the careers API.
# VITE_TURNSTILE_SITE_KEY=
